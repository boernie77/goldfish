# Goldfish — Beispiel-Umgebungsvariablen
# Kopiere diese Datei zu `.env` und passe die Werte an dein Setup an:
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Ohne `.env` läuft Goldfish trotzdem — die OIDC-Variablen sind alle optional,
# und wenn sie leer sind, blendet das Login-UI einfach keinen SSO-Knopf ein.

# ─────────────────────────────────────────────────────────────────────────────
# Hardware-Anpassungen (siehe docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────

# render-Group-ID auf deinem Host — Goldfish braucht sie, um auf /dev/dri
# zugreifen zu dürfen (VAAPI). Auf Debian/Ubuntu/Mint ist das oft 107,
# auf Arch/Fedora oft 989, auf Unraid 109. Prüfen mit:
#   getent group render
# (gibt z.B. "render:x:107:" → die Zahl ist deine GID)
# Auf manchen Distros heißt die Gruppe `video` statt `render`:
#   ls -l /dev/dri
RENDER_GID=107

# Pfad zu deinen Medien (read-only ins Container-/media gemountet).
# Beispiele:
#   /mnt/media           Standard-Linux
#   /mnt/user            Unraid
#   /volume1/Video       Synology
MEDIA_ROOT=/mnt/media

# ─────────────────────────────────────────────────────────────────────────────
# OIDC SSO (optional — alle 4 Variablen müssen gesetzt sein, sonst SSO aus)
# ─────────────────────────────────────────────────────────────────────────────
# Beispiel für Authentik (https://goauthentik.io/), funktioniert genauso mit
# Keycloak, Authelia, Zitadel und anderen OpenID-Connect-Providern.
#
# Setup im IdP:
#   1. Neuen OAuth2/OpenID-Provider anlegen
#      - Client-Type: Confidential
#      - Redirect-URI strict: https://<deine-goldfish-domain>/api/auth/oidc/callback
#      - Scopes: openid email profile
#      - Sub-Mode: user_email (sub = Email-Adresse)
#   2. Werte unten eintragen, dann `docker compose up -d`
#   3. In Goldfish den User anlegen (per Setup-Form oder Settings → Benutzer)
#   4. Username muss dem `preferred_username` aus dem IdP entsprechen,
#      sonst "Kein Goldfish-Konto für …"-Fehler beim ersten SSO-Login.
#
# OIDC_ISSUER_URL=https://auth.example.com/application/o/goldfish/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://goldfish.example.com/api/auth/oidc/callback

# ─────────────────────────────────────────────────────────────────────────────
# NVIDIA NVENC (optional — nur wenn dein Host eine CUDA-fähige NVIDIA-GPU
# UND den NVIDIA Container Runtime hat. Auf Unraid: erst NVIDIA-Plugin
# installieren, dann hier aktivieren.)
# ─────────────────────────────────────────────────────────────────────────────
# Auskommentieren in docker-compose.yml den `runtime: nvidia`-Block, plus
# diese ENV-Variablen lassen das Container-Toolkit die GPU durchreichen:
#
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
