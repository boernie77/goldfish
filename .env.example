# Goldfish Stack-Env (Portainer: Environment-Variables Tab)
# In Portainer NICHT als File hochladen — direkt in den Stack-Env-Block kopieren.
# Echte Werte NICHT ins Git committen.

# OIDC SSO via Authentik (alle 4 Variablen müssen gesetzt sein, sonst SSO aus)
OIDC_ISSUER_URL=https://auth.<your-domain>/application/o/goldfish/
OIDC_CLIENT_ID=<aus Authentik Admin: Anwendungen → Goldfish → Provider → Client-ID>
OIDC_CLIENT_SECRET=<aus Authentik Admin: Anwendungen → Goldfish → Provider → Client-Secret>
OIDC_REDIRECT_URL=https://goldfish.<your-domain>/api/auth/oidc/callback
