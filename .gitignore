# Build artefacts
/dist/
/out/
*.exe

# Local config / runtime data
/config/
*.db
*.db-shm
*.db-wal

# Environment / secrets
.env
.env.local

# Editors
.idea/
.vscode/
.DS_Store
*.swp

# Test artifacts
/coverage.out
/cmd/test*

# .claude/ is ignored by default (local settings etc.), but skills are
# shared, version-controlled instructions — keep those tracked.
/.claude/*
!/.claude/skills/
